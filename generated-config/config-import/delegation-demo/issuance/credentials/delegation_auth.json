{
  "$schema": "https://eudiplo.dev/schemas/v1/CredentialConfigFile.schema.json",
  "metadata": { "generation": 1 },
  "spec": {
    "id": "delegation_auth",
    "description": "Owner device enrollment and possession credential; contains no PID data.",
    "config": {
      "format": "dc+sd-jwt",
      "display": [
        { "name": "Delegation authorization", "locale": "en-US", "description": "Proves this holder enrolled with the delegation service." }
      ]
    },
    "vct": "https://delegations.example/vct/delegation-auth",
    "keyBinding": true,
    "keyChainId": "REPLACE_WITH_CREDENTIAL_SIGNING_KEY_CHAIN_ID",
    "statusManagement": true,
    "lifeTime": 31536000,
    "fields": [
      { "path": ["jti"], "type": "string", "mandatory": true, "disclosable": false },
      { "path": ["nbf"], "type": "integer", "mandatory": true, "disclosable": false },
      {
        "path": ["enrollment"], "type": "object", "mandatory": true, "disclosable": false,
        "children": [
          { "path": ["basis"], "type": "string", "mandatory": true, "disclosable": false, "defaultValue": "pid_verified" }
        ]
      },
      { "path": ["owner_id"], "type": "string", "mandatory": true, "disclosable": true }
    ]
  }
}
